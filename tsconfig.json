{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "strictNullChecks": true,

    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,

    "jsx": "react-jsx",
  },
  "include": ["src", "vite-env.d.ts", ".temp/traits"]
}