{
  "name": "klados",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000",
    "build": "vite build && cp instrument.server.mjs .output/server",
    "build:keygen": "tsc -p keygen/tsconfig.json",
    "start": "npm run db:migrate && node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:drop-create": "psql \"postgres://app:app@127.0.0.1:5434/postgres\" -v ON_ERROR_STOP=1 -c \"DROP DATABASE IF EXISTS taxokeys;\" -c \"CREATE DATABASE taxokeys;\"",
    "db:reset": "npm run db:drop-create && npm run db:generate && npm run db:migrate",
    "db:seed:colors": "tsx scripts/seeding/colors/seedColors.ts",
    "db:seed:units": "tsx scripts/seeding/units/seedUnits.ts",
    "db:seed": "npm run db:seed:colors && npm run db:seed:units",
    "db:dump": "docker exec taxokeys-db-1 pg_dump -U app -d taxokeys --clean --if-exists > .backups/dev-$(date +%F).sql",
    "db:load": "docker exec -i taxokeys-db-1 psql -U app -d taxokeys",
    "test:colors": "tsx scripts/seeding/colors/testColors.ts",
    "test:keygen": "tsx scripts/runKeygen.ts",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/openai": "^3.0.53",
    "@ariakit/react": "^0.4.20",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@better-auth/drizzle-adapter": "1.7.0-rc.2",
    "@dagrejs/dagre": "^1.1.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ebay/nice-modal-react": "^1.2.13",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/themes": "^3.2.1",
    "@sentry/tanstackstart-react": "^10.36.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.157.5",
    "@tanstack/react-router-ssr-query": "^1.157.5",
    "@tanstack/react-start": "^1.157.5",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.10.0",
    "ai": "^6.0.168",
    "better-auth": "1.7.0-rc.2",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "headless-toast": "github:ethansaso/headless-toast",
    "nitro": "^3.0.260610-beta",
    "pg": "^8.16.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.68.0",
    "react-icons": "^5.5.0",
    "resend": "^6.8.0",
    "use-debounce": "^10.0.6",
    "uuid": "^13.0.0",
    "vite": "^8.0.8",
    "zod": "^4.2.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@eslint/js": "^10.0.1",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^5.1.2",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint-plugin-boundaries": "^7.1.0",
    "playwright": "^1.61.1",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "better-auth": {
      "drizzle-orm": "$drizzle-orm"
    }
  }
}
